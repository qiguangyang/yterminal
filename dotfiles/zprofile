# Initialize Homebrew if installed (Apple Silicon, Intel mac, or Linuxbrew).
# Silently no-ops on systems without brew (e.g. apt-only Ubuntu).
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x "$_brew" ]]; then
    eval "$("$_brew" shellenv zsh)"
    break
  fi
done
unset _brew
